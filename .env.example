# Supabase (Phase 2)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Market data (Phase 3)
# Yahoo Finance needs no API key. It also sends no CORS headers, so price
# requests always go through a proxy. Leave this unset in development: the Vite
# dev server proxies /api/market itself. For a deployed build, deploy
# supabase/functions/market-data and point this at it, e.g.
#   https://<project-ref>.supabase.co/functions/v1/market-data
VITE_MARKET_PROXY_URL=

# Only needed if you swap in a keyed provider (Alpha Vantage, Polygon, ...)
VITE_MARKET_DATA_API_KEY=

# Server-side only — never expose these to the browser bundle, and never give
# them a VITE_ prefix (anything VITE_* is compiled into the JavaScript users
# download). These belong in the environment of whatever runs
# `python -m gann.refresh`: your shell, a cron job, or GitHub Actions secrets.
SUPABASE_SERVICE_ROLE_KEY=

# AI mentor (Phase 6). Without it, signals are still computed and cached, just
# without the plain-language summary.
OPENROUTER_API_KEY=
# Optional. Defaults to anthropic/claude-haiku-4.5 — the engine has already done
# the reasoning, so this only rephrases numbers. See the README before switching
# to a free model: the ones tested were rate-limited or could not write Hebrew.
OPENROUTER_MODEL=
