# Supabase (Phase 2)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Market data (Phase 3)
# Yahoo Finance needs no API key. It also sends no CORS headers, so price
# requests always go through a proxy. Leave this unset in development: the Vite
# dev server proxies /api/market itself. For a deployed build, deploy
# supabase/functions/market-data and point this at it, e.g.
#   https://<project-ref>.supabase.co/functions/v1/market-data
VITE_MARKET_PROXY_URL=

# Only needed if you swap in a keyed provider (Alpha Vantage, Polygon, ...)
VITE_MARKET_DATA_API_KEY=

# Server-side only — never expose these to the browser bundle.
# Used by Supabase Edge Functions / the Gann service in later phases.
OPENROUTER_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
